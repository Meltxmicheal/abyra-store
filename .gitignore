# Dependencies
node_modules/
dist/
build/
.next/

# Environment Variables — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Allow example/template env files (no real secrets inside)
!.env.production.example
!.env.example

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Scratch and Temp
scratch/
temp/
tmp/
