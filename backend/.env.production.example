# ============================================================
# ABYRA STORE — Backend Production Environment Variables
# ============================================================
# DO NOT commit .env or .env.production to git.
# Copy this file as a reference when filling Render's dashboard.
# ============================================================

NODE_ENV=production
PORT=5000

# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://hgayhvaskddmcetltkca.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_PROJECT_REF=hgayhvaskddmcetltkca

# ─── Razorpay ───────────────────────────────────────────────
# Switch to live keys (rzp_live_...) when going to production payments
RAZORPAY_KEY_ID=rzp_test_SlAlrOvj6A2XAR
RAZORPAY_KEY_SECRET=<your-razorpay-secret>

# ─── Resend (Email) ─────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=abyrasupport@meltazi.me

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=dze1d3uen
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ─── Security ───────────────────────────────────────────────
ENCRYPTION_KEY=<generate-a-strong-random-key-min-32-chars>

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Include both your custom domain AND the vercel.app preview URL
ALLOWED_ORIGINS=https://abyra.store,https://www.abyra.store,https://abyra-store.vercel.app

# ─── URL References ─────────────────────────────────────────
# Used in email links — your production frontend URL
VITE_FRONTEND_URL=https://abyra.store

# Used for self-referencing receipt generation (your Render service URL)
BACKEND_URL=https://abyra-backend.onrender.com
